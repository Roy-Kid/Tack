{
  "name": "@tack/molplot",
  "version": "0.1.0",
  "description": "Tack capability: build an interactive MolPlot chart and open the MolPlot workbench",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "tack-plugin"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rslib build"
  },
  "tack": {
    "compat": ">=0.2.0 <1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
