{
  "name": "@tack/agent-claude",
  "version": "0.3.0",
  "description": "Claude Agent SDK as a delegated agent runtime for Tack (a DSH subagent provider)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "tack-plugin"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rslib build"
  },
  "tack": {
    "compat": ">=0.7.0 <1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@tack/dsh-shims": "0.1.0"
  }
}
