{
  "name": "@tack/ui",
  "version": "0.1.0",
  "description": "Tack brand for the DSH browser shell",
  "license": "MIT",
  "type": "module",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml"],
  "scripts": { "build": "rslib build" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
