{
  "name": "tack-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bundles/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @tack/plugins -w @tack/delegate -w @tack/agent-claude -w @tack/web-chrome -w tack",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/web-chrome/tsconfig.json --noEmit",
    "lint": "rslint --type-check",
    "test": "npm run build && rstest run",
    "test:unit": "rstest run tests/unit",
    "test:e2e": "npm run build && rstest run -c rstest.e2e.config.ts",
    "setup": "npm ci && npm run build && npm link -w tack && node packages/tack/lib/bin.js doctor",
    "test:agent": "npm run build && rstest run tests/integration/agent.test.ts tests/integration/delegate.test.ts",
    "test:install": "rstest run -c rstest.install.config.ts",
    "test:live": "npm run build && node scripts/live-smoke.ts"
  },
  "devDependencies": {
    "@rslib/core": "1.0.2",
    "@rslint/core": "0.9.3",
    "@rstest/core": "0.12.2",
    "@types/node": "26.6.2",
    "@types/react": "18.3.31",
    "@types/semver": "7.8.0",
    "playwright-core": "1.63.0",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  }
}
